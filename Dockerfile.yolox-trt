# ==============================
# YOLOX Docker (GPU) with TensorRT Support
# Base: NVIDIA TensorRT Container (smaller than PyTorch container)
# ==============================
FROM nvcr.io/nvidia/tensorrt:26.02-py3

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    libglib2.0-0 \
    ffmpeg \
    libsm6 \
    libxext6 \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

WORKDIR /workspace

# Clone YOLOX repo at specific commit
RUN git clone https://github.com/Megvii-BaseDetection/YOLOX.git && \
    cd YOLOX && \
    git checkout 6ddff4824372906469a7fae2dc3206c7aa4bbaee

WORKDIR /workspace/YOLOX

# Replace requirements.txt with compatible versions for TensorRT container
# TensorRT 26.02 comes with PyTorch 2.6.x, so we match those versions
RUN tee requirements.txt << EOF
# Core YOLOX deps
numpy>=1.24.0
torchvision==0.19.1
opencv-python>=4.8.0
loguru>=0.7.0
tqdm>=4.66.0
thop>=0.1.1
ninja>=1.11.0
tabulate>=0.9.0
tensorboard>=2.15.0
psutil==7.2.2

# verified versions
pycocotools>=2.0.7
onnx>=1.15.0
onnxsim>=0.4.36

Pillow>=10.0.0
EOF

# Install Python Dependencies
RUN pip install --no-cache-dir -r requirements.txt --no-build-isolation

# Install YOLOX editable
RUN pip install -v -e . --no-build-isolation

# This is SHA256 hash of yolox_s.pth, weight file from official github repo release 0.1.1rc0 (68.7 MB)
ENV YOLOX_S_SHA256="f55ded7181e1b0c13285c56e7790b8f0e8f8db590fe4edb37f0b7f345c913a30"

# Download pretrained weights + SHA256 integrity check
RUN mkdir -p weights && \
    wget https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_s.pth -O weights/yolox_s.pth --no-verbose && \
    echo "${YOLOX_S_SHA256} weights/yolox_s.pth" | sha256sum -c - || \
    (echo "ERROR: SHA256 mismatch for yolox_s.pth! Expected: ${YOLOX_S_SHA256}" && exit 1) && \
    ls -lh weights/yolox_s.pth && \
    echo "Weights integrity verified (SHA256 matches ${YOLOX_S_SHA256})"

# Quick test that weights load
RUN python -c "import torch; ckpt = torch.load('weights/yolox_s.pth', map_location='cpu'); print('Weights loaded OK, keys:', len(ckpt.keys()))"

# Test TensorRT installation
RUN python -c "import tensorrt as trt; print('TensorRT version:', trt.__version__)"

# Suppress torch.load FutureWarning
ENV PYTHONWARNINGS="ignore:You are using `torch.load` with `weights_only=False`:FutureWarning"

# Default: interactive shell
CMD ["bash"]
